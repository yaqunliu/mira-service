# ============================================================
# Mira 后端 —— Docker 部署环境变量模板
#
# 用法：
#   cp env.docker.example .env
#   然后填写下面标 [必填] 的项
#
# 与 env.example 的区别：
#   env.example 是本地开发配置（一律 localhost），直接拿到 Docker 里连不上任何服务。
#   本文件已改为 compose 服务名，并按「IP 直连 / 无域名 / 暂不接支付」的演示场景裁剪。
#
# 场景假设：
#   - 前端通过 Next 同源代理访问后端（方案 B），因此不需要配 CORS
#   - Supabase 用云项目，非对称 ES256 签名，因此 SUPABASE_JWT_SECRET 留空
#
# 约定：注释单独占行，不要写在值的后面。
# ============================================================


# ------------------------------------------------------------
# 数据库 [必填]
#
# DATABASE_HOST 必须是 compose 里的服务名 postgres，不能是 localhost
# —— 容器里的 localhost 指容器自己。
#
# 下面三项同时被 docker-compose.yml 用来初始化 postgres 容器
# （${DATABASE_NAME:?} 等），任何一项为空都会让 docker compose 直接拒绝启动。
# ------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=mira
DATABASE_PASSWORD=
DATABASE_NAME=video_generator

# ⚠️ DATABASE_URL 必须留空。
# config.py 的逻辑是「DATABASE_URL 非空时直接使用它，忽略上面的 HOST/PORT/USER/...」。
# env.example 里这一项被填成了 localhost 地址，照抄会导致
# 即使 DATABASE_HOST 改对了也依然连不上数据库。
DATABASE_URL=


# ------------------------------------------------------------
# Redis [必填]
#
# 主机名同样必须是服务名 redis。
# REDIS_PASSWORD 为空时 docker-compose 会拒绝启动（${REDIS_PASSWORD:?}）。
# 密码填好后，config.py 的 assemble_redis_urls 会自动把它拼进下面三个 URL，
# 所以这三个 URL 里不用手写密码，但主机名要自己写对。
#
# 生成强密码：openssl rand -base64 24
# ------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_BACKEND_URL=redis://redis:6379/1


# ------------------------------------------------------------
# Supabase 认证 [必填]
#
# ⚠️ SUPABASE_URL 填 Project URL，**不要带任何路径后缀**。
#    正确：https://xxxxxxxx.supabase.co
#    错误：https://xxxxxxxx.supabase.co/rest/v1/   ← 那是 Data API 地址
#
# 填错的表现：注册登录一律失败，后端日志报「获取 Supabase JWKS 签名公钥失败」。
# 自检方法（应返回 HTTP 200 且内容是一组 keys）：
#    curl -s <SUPABASE_URL>/auth/v1/.well-known/jwks.json
#
# SUPABASE_JWT_SECRET 说明：
#   云项目使用非对称签名（ES256/RS256）时留空即可，验签公钥由 JWKS 动态获取。
#   仅当使用本地 supabase CLI（HS256）时才需要填。
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=


# ------------------------------------------------------------
# 应用与跨域
#
# DEBUG 保持 False：设为 True 会额外开放 /points/test/add-points
# （可给任意用户加积分的测试接口）。
#
# BACKEND_CORS_ORIGINS 在方案 B（Next 同源代理）下留空即可 ——
# 浏览器只与前端同源通信，后端调用是服务端到服务端，不产生跨域。
#
# ⚠️ 若将来改回「浏览器直连后端」，这一项必须填成前端地址，例如
#    BACKEND_CORS_ORIGINS=http://45.130.164.189:8001
#    否则 DEBUG=False + 空值时，app/main.py 根本不装载 CORS 中间件，
#    只打一句 UserWarning，浏览器侧全被拦却查不出原因。
# ------------------------------------------------------------
APP_NAME=Video Generator API
APP_VERSION=0.1.0
DEBUG=False
LOG_LEVEL=INFO
BACKEND_CORS_ORIGINS=

# 反向代理/域名接入后可收紧为具体主机名，IP 直连阶段保持 *
ALLOWED_HOSTS=*

UPLOAD_DIR=./uploads


# ------------------------------------------------------------
# 演示省钱开关
#
# 打开后不调用真实的图片/视频生成 API，直接返回固定占位地址。
# 建议第一次跑通链路时先设 True，确认流程无误后再改 False 出真片。
# ------------------------------------------------------------
DEBUG_GENERATE_IMAGE=True
DEBUG_GENERATE_VIDEO=True


# ------------------------------------------------------------
# LLM（角色 / 场景 / 分镜 / 剧本解析）
# OpenAI 兼容的聚合网关
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL_NAME=moonshotai/Kimi-K2-Instruct-0905
LLM_MODEL_CHARACTER_ANALYSIS=zai-org/glm-4.6
LLM_MODEL_SCENE_ANALYSIS=zai-org/glm-4.6
LLM_MODEL_SHOT_ANALYSIS=zai-org/glm-4.6
LLM_MODEL_SCRIPT_GENERATION=zai-org/glm-4.6
LLM_MODEL_PROMPT_GENERATION=Qwen/Qwen-Plus


# ------------------------------------------------------------
# 图片 / 视频生成
#
# ARK_API_KEY 是火山方舟直连通道的密钥。
# 若文生图/图生图实际走的是上面的 OPENAI_BASE_URL 聚合网关，则可不填 ——
# 建议先用 DEBUG_GENERATE_IMAGE=True 跑通链路，再按真实报错决定补哪个 key。
# ------------------------------------------------------------
IMAGE_MODEL_TEXT_TO_IMAGE=doubao-seedream-5-0-260128
IMAGE_MODEL_IMAGE_TO_IMAGE=doubao-seedream-5-0-260128

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

AI_TIMEOUT=600
AI_IMAGE_DOWNLOAD_TIMEOUT=60
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2


# ------------------------------------------------------------
# TTS 配音
# ------------------------------------------------------------
FISH_AUDIO_API_KEY=
FISH_AUDIO_DEFAULT_VOICE_ID=54a5170264694bfc8e9ad98df7bd89c3
FISH_AUDIO_DEFAULT_MODEL=s1


# ------------------------------------------------------------
# 字幕字体
# 首次使用会从 SUBTITLE_FONT_URL 自动下载到 FONT_DIR
# ------------------------------------------------------------
FONT_DIR=static/fonts
SUBTITLE_FONT_URL=https://novel-agent.cn-sh2.ufileos.com/font/black.ttf
SUBTITLE_FONT_NAME=black.ttf


# ------------------------------------------------------------
# 对象存储 US3 [出片必填]
#
# 生成的图片和视频都存这里。不配的话生成流程会在存储环节中断。
# ------------------------------------------------------------
US3_PUBLIC_KEY=
US3_PRIVATE_KEY=
US3_BUCKET=
US3_REGION=
DEFAULT_BUCKET=
DOWNLOAD_SUFFIX=
UPLOAD_SUFFIX=


# ------------------------------------------------------------
# 积分系统
# 注册赠送 10000 积分，演示足够用，无需再手工加积分
# ------------------------------------------------------------
POINTS_REGISTER_REWARD=10000
POINTS_CHECKIN_REWARD=188
POINTS_CHECKIN_EXPIRE_HOURS=0


# ------------------------------------------------------------
# 支付（本轮不接，全部留空）
#
# Creem（海外）与微信支付相关配置全部省略。
# 需要时从 env.example 里对应段落拷回来。
# 注意 celery_beat 当前在 docker-compose.yml 中已注释关闭，
# 积分过期、订阅续费、订单轮询等定时任务不会执行。
# ------------------------------------------------------------
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=


# ------------------------------------------------------------
# 以下字段代码中已不再使用，保留仅为向后兼容，无需填写
#   SECRET_KEY / ALGORITHM  —— 认证已全部走 Supabase
#   ENV                     —— Python 代码中无任何引用
# ------------------------------------------------------------
SECRET_KEY=
