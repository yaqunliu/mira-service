# ============================================================
# Mira 后端 —— Docker 部署环境变量模板
#
# 用法：
#   cp env.docker.example .env
#   然后填写下面标 [必填] 的项
#
# 与 env.example 的区别：
#   env.example 是本地开发配置（一律 localhost），直接拿到 Docker 里连不上任何服务。
#   本文件已改为 compose 服务名，并按「IP 直连 / 无域名 / 暂不接支付」的演示场景裁剪。
#
# 场景假设：
#   - 前端通过 Next 同源代理访问后端（方案 B），因此不需要配 CORS
#   - Supabase 用云项目，非对称 ES256 签名，因此 SUPABASE_JWT_SECRET 留空
#
# 约定：注释单独占行，不要写在值的后面。
# ============================================================


# ------------------------------------------------------------
# 数据库 [必填]
#
# DATABASE_HOST 必须是 compose 里的服务名 postgres，不能是 localhost
# —— 容器里的 localhost 指容器自己。
#
# 下面三项同时被 docker-compose.yml 用来初始化 postgres 容器
# （${DATABASE_NAME:?} 等），任何一项为空都会让 docker compose 直接拒绝启动。
#
# 生成强密码：openssl rand -hex 32（理由见下面 REDIS_PASSWORD 处的说明）
#
# ⚠️ DATABASE_PASSWORD 只在数据卷为空时用于初始化 postgres，改了之后
#    光重启不生效，必须重建卷：无数据用 docker compose down -v，
#    有数据先 pg_dump 导出再导入。
# ------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=mira
DATABASE_PASSWORD=
DATABASE_NAME=video_generator

# ⚠️ DATABASE_URL 必须保持「整行注释」状态，不要写成 DATABASE_URL=（空值）。
#
# 两个原因：
#   1. 声明类型是 Optional[PostgresDsn]（config.py:38）。Optional 表示可以是
#      None，不是可以是空字符串。写成 DATABASE_URL= 时 pydantic 拿到的是 ''，
#      会去按 URL 解析空串并失败：
#        ValidationError: Input should be a valid URL, input is empty
#   2. 非空时 assemble_db_connection（config.py:41）不会执行自动拼装，
#      上面的 DATABASE_HOST/USER/PASSWORD/NAME 全部被忽略。
#
# 保持注释即可 —— 连接串会由 assemble_db_connection 自动拼出来。
# DATABASE_URL=


# ------------------------------------------------------------
# Redis [必填]
#
# 主机名同样必须是服务名 redis。
# REDIS_PASSWORD 为空时 docker-compose 会拒绝启动（${REDIS_PASSWORD:?}）。
# 密码填好后，config.py 的 assemble_redis_urls 会自动把它拼进下面三个 URL，
# 所以这三个 URL 里不用手写密码，但主机名要自己写对。
#
# 生成强密码：openssl rand -hex 32
#   ⚠️ 不要用 openssl rand -base64 —— 它的字符集含 "/"、"+"、"="。
#      密码会被拼进 redis://:密码@host:port/db，"/" 会截断 URL；
#      而 REDIS_URL 声明为 str 不做校验，拼坏了不报错，
#      表现为「worker 日志 ready 但任务永不执行」。
#      config.py 现在已对密码做 percent-encode，但仍建议用 -hex 省事。
# ------------------------------------------------------------
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_BACKEND_URL=redis://redis:6379/1


# ------------------------------------------------------------
# Supabase 认证 [必填]
#
# ⚠️ SUPABASE_URL 填 Project URL，**不要带任何路径后缀**。
#    正确：https://xxxxxxxx.supabase.co
#    错误：https://xxxxxxxx.supabase.co/rest/v1/   ← 那是 Data API 地址
#
# 填错的表现：注册登录一律失败，后端日志报「获取 Supabase JWKS 签名公钥失败」。
# 自检方法（应返回 HTTP 200 且内容是一组 keys）：
#    curl -s <SUPABASE_URL>/auth/v1/.well-known/jwks.json
#
# SUPABASE_JWT_SECRET 说明：
#   云项目使用非对称签名（ES256/RS256）时留空即可，验签公钥由 JWKS 动态获取。
#   仅当使用本地 supabase CLI（HS256）时才需要填。
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=


# ------------------------------------------------------------
# 应用与跨域
#
# DEBUG 保持 False：设为 True 会额外开放 /points/test/add-points
# （可给任意用户加积分的测试接口）。
#
# BACKEND_CORS_ORIGINS 在方案 B（Next 同源代理）下不需要配 ——
# 浏览器只与前端同源通信，后端调用是服务端到服务端，不产生跨域。
#
# ⚠️ 但「不需要」必须表达为整行注释，不能写成 BACKEND_CORS_ORIGINS=（空值）。
#    该字段声明为 List[AnyHttpUrl]（config.py:20），pydantic-settings 对复杂
#    类型会先做 json.loads，空字符串不是合法 JSON，启动直接失败：
#      SettingsError: error parsing value for field "BACKEND_CORS_ORIGINS"
#    注意这个失败发生在配置源层，config.py:23 那个 mode="before" 的
#    field_validator 根本没机会执行（它是按 pydantic v1 语义写的，已失效）。
#
# ⚠️ 若将来改回「浏览器直连后端」，值必须是 JSON 数组，不能是逗号分隔：
#      正确：BACKEND_CORS_ORIGINS=["http://45.130.164.189:8001"]
#      错误：BACKEND_CORS_ORIGINS=http://45.130.164.189:8001     ← 同样非法 JSON
#    未配置时 DEBUG=False 会让 app/main.py 完全不装载 CORS 中间件，
#    只打一句 UserWarning，浏览器侧全被拦却查不出原因。
# ------------------------------------------------------------
APP_NAME=Video Generator API
APP_VERSION=0.1.0
DEBUG=False
LOG_LEVEL=INFO
# BACKEND_CORS_ORIGINS=["http://example.com"]

# TrustedHostMiddleware 的白名单，声明为 List[str]（config.py:21），
# 因此必须是 JSON 数组 —— 裸的 * 不是合法 JSON，会和上面同样的方式启动失败。
#
# 方案 B 下保持 ["*"]：后端收到的 Host 是 mira-api:8100（前端服务端代理的目标），
# 公网 IP/域名它根本看不到，收紧成公网地址反而会把所有请求拦掉。
ALLOWED_HOSTS=["*"]

UPLOAD_DIR=./uploads


# ------------------------------------------------------------
# 演示省钱开关
#
# 打开后不调用真实的图片/视频生成 API，直接返回下面的固定占位地址。
#
# 注意这个开关在 ai_client 的最外层生效（generate_image_by_prompt 一进来就返回），
# 所以打开时无论模型配成什么都不会真的出图，日志里会打
#   [DEBUG] 图片生成模式，直接返回固定地址: ...
# 见到这一行就说明当前是占位模式，不是接口通了。
#
# 另外占位地址默认指向 US3 桶，US3 未开通时那个地址取不回来，
# 下游拿去下载会报 400 —— 要用占位模式就得换成一张真正能公开访问的图。
# ------------------------------------------------------------
DEBUG_GENERATE_IMAGE=False
DEBUG_GENERATE_VIDEO=True
# DEBUG_GENERATE_IMAGE_URL=https://example.com/placeholder.png
# DEBUG_GENERATE_VIDEO_URL=https://example.com/placeholder.mp4


# ------------------------------------------------------------
# 演示模式：跳过积分校验
#
# True 时余额不足也放行，积分可以扣成负数（记录照常写，账目可追溯）。
# 只为演示期不被"积分不足"卡住；演示结束后改回 False 重启即可，无需改代码。
#
# 注意：这会同时放开所有生成入口（角色图/场景图/分镜图/视频），
# 真实 API 调用照常产生费用 —— 想连费用一起省，配合上面的
# DEBUG_GENERATE_IMAGE=True 使用。
# ------------------------------------------------------------
POINTS_CHECK_DISABLED=False


# ------------------------------------------------------------
# LLM（角色 / 场景 / 分镜 / 剧本解析）
# OpenAI 兼容的聚合网关 —— 当前接的是 siray 中转站
#
# 模型名必须带厂商前缀，且与 docs.siray.ai/api-reference/model-api/<模型>.md
# 里的 enum 完全一致，写错会 400 或落到别的渠道。
#
# 注意 LLM_MODEL_NAME 只是兜底：各解析步骤实际读的是下面五个专用变量
# （见 ai_client.py 的 character_analysis_model 等），只改 LLM_MODEL_NAME 不生效。
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siray.ai/v1
LLM_MODEL_NAME=z-ai/glm-5.2
LLM_MODEL_CHARACTER_ANALYSIS=z-ai/glm-5.2
LLM_MODEL_SCENE_ANALYSIS=z-ai/glm-5.2
LLM_MODEL_SHOT_ANALYSIS=z-ai/glm-5.2
LLM_MODEL_SCRIPT_GENERATION=z-ai/glm-5.2
LLM_MODEL_PROMPT_GENERATION=z-ai/glm-5.2


# ------------------------------------------------------------
# 图片 / 视频生成
#
# siray 的图片接口是异步的（提交拿 task_id，再轮询），与 OpenAI 的同步
# images.generate 不是一个协议，走 ai_client 里的专用适配器。
# 模型 ID 带 -t2i / -i2i / -edit / -ref2i 后缀时自动识别为 siray 通道。
#
# 两点容易配错：
#   1. 文生图必须用 -t2i 结尾的模型。-i2i / -edit 的参考图字段是必填的，
#      拿去做文生图会被接口拒绝（适配器会提前抛出可读的错误）。
#   2. siray 的图片模型有两套请求体：seedream 系 size 是像素（2560x1440），
#      qwen 系 size 是档位（2k）且要额外传 aspect_ratio。适配器按模型 ID 自动区分，
#      但换成没核对过 spec 的模型（flux / nano-banana / midjourney 等）前请先看文档。
#
# SIRAY_API_KEY / SIRAY_BASE_URL 留空则复用上面的 OPENAI_* （siray 是统一 key）。
# ARK_API_KEY 是火山方舟直连通道的密钥，用 siray 时不需要。
# ------------------------------------------------------------
IMAGE_MODEL_TEXT_TO_IMAGE=bytedance/seedream-4.5-t2i
IMAGE_MODEL_IMAGE_TO_IMAGE=bytedance/seedream-4.5-i2i
# 可选（已核对过 spec）：alibaba/qwen-image-3-t2i / alibaba/qwen-image-3-edit

SIRAY_API_KEY=
SIRAY_BASE_URL=
# 轮询间隔与单张图的最长等待时间（秒）。SIRAY_IMAGE_TIMEOUT 必须小于 AI_TIMEOUT，
# 否则外层的线程池超时会先把轮询掐断。
SIRAY_IMAGE_POLL_INTERVAL=3
SIRAY_IMAGE_TIMEOUT=280

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

AI_TIMEOUT=600
AI_IMAGE_DOWNLOAD_TIMEOUT=60
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2


# ------------------------------------------------------------
# TTS 配音
# ------------------------------------------------------------
FISH_AUDIO_API_KEY=
FISH_AUDIO_DEFAULT_VOICE_ID=54a5170264694bfc8e9ad98df7bd89c3
FISH_AUDIO_DEFAULT_MODEL=s1


# ------------------------------------------------------------
# 字幕字体
# 首次使用会从 SUBTITLE_FONT_URL 自动下载到 FONT_DIR
# ------------------------------------------------------------
FONT_DIR=static/fonts
SUBTITLE_FONT_URL=https://novel-agent.cn-sh2.ufileos.com/font/black.ttf
SUBTITLE_FONT_NAME=black.ttf


# ------------------------------------------------------------
# 对象存储 US3 [出片必填]
#
# 生成的图片和视频都存这里。不配的话生成流程会在存储环节中断。
#
# 注意：留空不会报错，而是自动降级到下面的本地存储（见 LOCAL_STORAGE_*）。
# 之前小说上传后章节列表为空就是这里没配导致的——章节文本上传失败后被静默
# 跳过，一个章节都没落库。
# ------------------------------------------------------------
US3_PUBLIC_KEY=
US3_PRIVATE_KEY=
US3_BUCKET=
US3_REGION=
DEFAULT_BUCKET=
DOWNLOAD_SUFFIX=
UPLOAD_SUFFIX=


# ------------------------------------------------------------
# 本地存储 [US3 未开通时的降级方案]
#
# 生效条件：LOCAL_STORAGE_ENABLED=true，或上面的 US3 公私钥任一为空。
# 买了 US3 把公私钥填上后会自动切回 US3，不需要改代码。
#
# api 与 celery_worker 都挂载了 ./:/app，所以文件在两个容器间天然互通。
#
# PUBLIC_BASE_URL 决定存进数据库的地址形态，这个项目里【必须填】：
#   留空 -> 存容器内绝对路径（/app/local_storage/...），服务端读文件没问题，
#           但浏览器访问不到，页面上的图片会全部 404。
#   填了 -> 存 {PUBLIC_BASE_URL}/uploads/...，浏览器和服务端都能用。
#
# 填对外访问的地址（带端口，末尾不要斜杠），例如：
#   PUBLIC_BASE_URL=http://45.130.164.189:8001
# 注意 8001 是前端容器的端口：api 容器只监听 127.0.0.1:8100 不对公网暴露，
# 所以前端 next.config.js 里有一条 /uploads/* -> mira-api:8100 的反代，
# 两者要一起改，只改一边图片仍然打不开。
#
# 改了这个值之后，之前已经存进库的绝对路径不会自动变，
# 用 scripts/migrate_local_storage_urls.py 批量转换。
# ------------------------------------------------------------
LOCAL_STORAGE_ENABLED=
LOCAL_STORAGE_DIR=./local_storage
PUBLIC_BASE_URL=http://45.130.164.189:8001


# ------------------------------------------------------------
# 积分系统
# 注册赠送 10000 积分，演示足够用，无需再手工加积分
# ------------------------------------------------------------
POINTS_REGISTER_REWARD=10000
POINTS_CHECKIN_REWARD=188
POINTS_CHECKIN_EXPIRE_HOURS=0


# ------------------------------------------------------------
# 支付（本轮不接，全部留空）
#
# Creem（海外）与微信支付相关配置全部省略。
# 需要时从 env.example 里对应段落拷回来。
# 注意 celery_beat 当前在 docker-compose.yml 中已注释关闭，
# 积分过期、订阅续费、订单轮询等定时任务不会执行。
# ------------------------------------------------------------
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=


# ------------------------------------------------------------
# 以下字段代码中已不再使用，保留仅为向后兼容，无需填写
#   SECRET_KEY / ALGORITHM  —— 认证已全部走 Supabase
#   ENV                     —— Python 代码中无任何引用
# ------------------------------------------------------------
SECRET_KEY=
