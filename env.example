# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/video_generator
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=video_generator
DATABASE_USER=username
DATABASE_PASSWORD=password

# JWT配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis配置
# Redis 数据库编号说明：
# - /0: 数据库0（默认数据库）
# - /1: 数据库1
# - Redis 默认有 16 个数据库（0-15），不同数据库之间数据完全隔离
REDIS_URL=redis://localhost:6379/0  # 通用 Redis URL（向后兼容，可选）
REDIS_BROKER_URL=redis://localhost:6379/0  # Celery Broker（任务队列）
REDIS_BACKEND_URL=redis://localhost:6379/1  # Celery Backend（结果存储）

# 文件存储配置
UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=104857600  # 100MB in bytes (可选，有默认值)

# AI服务配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# 云存储配置 (US3)
US3_PUBLIC_KEY=your-us3-public-key
US3_PRIVATE_KEY=your-us3-private-key
US3_BUCKET=your-bucket-name
US3_REGION=cn-sh2

# 应用配置
APP_NAME=Video Generator API
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# CORS配置（允许的前端域名，多个用逗号分隔）
# 开发环境可以留空，将允许所有源
# 生产环境建议配置具体域名，如：http://localhost:3000,https://example.com
BACKEND_CORS_ORIGINS=
