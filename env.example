# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/video_generator
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=video_generator
DATABASE_USER=username
DATABASE_PASSWORD=password

# JWT配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis配置
REDIS_URL=redis://localhost:6379/0

# 文件存储配置
UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=104857600  # 100MB in bytes (可选，有默认值)

# AI服务配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# 云存储配置 (US3)
US3_PUBLIC_KEY=your-us3-public-key
US3_PRIVATE_KEY=your-us3-private-key
US3_BUCKET=your-bucket-name
US3_REGION=cn-sh2

# 应用配置
APP_NAME=Video Generator API
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO
