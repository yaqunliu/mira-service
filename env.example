# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/video_generator
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=video_generator
DATABASE_USER=username
DATABASE_PASSWORD=password

# JWT配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时（60分钟 * 24）

# Redis配置
# Redis 数据库编号说明：
# - /0: 数据库0（默认数据库）
# - /1: 数据库1
# - Redis 默认有 16 个数据库（0-15），不同数据库之间数据完全隔离
REDIS_URL=redis://localhost:6379/0  # 通用 Redis URL（向后兼容，可选）
REDIS_BROKER_URL=redis://localhost:6379/0  # Celery Broker（任务队列）
REDIS_BACKEND_URL=redis://localhost:6379/1  # Celery Backend（结果存储）

# 文件存储配置
UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=104857600  # 100MB in bytes (可选，有默认值)

# AI服务配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=moonshotai/Kimi-K2-Instruct-0905

# 图片生成模型配置
# 文生图模型（用于生成角色图片）
IMAGE_MODEL_TEXT_TO_IMAGE=your-text-to-image-model
# 图生图模型（用于生成分镜图片）
IMAGE_MODEL_IMAGE_TO_IMAGE=black-forest-labs/flux-kontext-pro/multi
# 旧配置（已废弃，保留用于向后兼容）
# IMAGE_MODEL_NAME=your-image-model-name

# Fish Audio TTS 配置
FISH_AUDIO_API_KEY=your-fish-audio-api-key
FISH_AUDIO_DEFAULT_VOICE_ID=54a5170264694bfc8e9ad98df7bd89c3  # 默认语音模型ID（丁真）

# 字体配置（用于字幕渲染）
FONT_DIR=static/fonts  # 字体文件本地存储目录
SUBTITLE_FONT_URL=https://novel-agent.cn-sh2.ufileos.com/font/black.ttf  # 字幕字体下载地址
SUBTITLE_FONT_NAME=black.ttf  # 字幕字体文件名

# 云存储配置 (US3)
US3_PUBLIC_KEY=your-us3-public-key
US3_PRIVATE_KEY=your-us3-private-key
DOWNLOAD_SUFFIX=""
UPLOAD_SUFFIX=""
DEFAULT_BUCKET=""
US3_BUCKET=your-bucket-name
US3_REGION=""


# 应用配置
APP_NAME=Video Generator API
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO

# CORS配置（允许的前端域名，多个用逗号分隔）
# 开发环境可以留空，将允许所有源
# 生产环境建议配置具体域名，如：http://localhost:3000,https://example.com
BACKEND_CORS_ORIGINS=

# 积分系统配置
# 注册赠送
POINTS_REGISTER_REWARD=100  # 注册赠送积分

# 每日签到
POINTS_CHECKIN_REWARD=10  # 每日签到积分
POINTS_CHECKIN_EXPIRE_HOURS=24  # 签到积分过期时间（小时），0表示当天00:00过期

# 积分消耗配置（格式：operation_type:计费方式:数值）
POINTS_CREATE_CREATION=create_creation:per_unit:10
POINTS_GENERATE_CHARACTER=generate_character:per_unit:5
POINTS_GENERATE_SHOT=generate_shot:per_unit:3
POINTS_GENERATE_AUDIO=generate_audio:per_second:1
POINTS_GENERATE_VIDEO=generate_video:per_shot:2
POINTS_UPLOAD_NOVEL=upload_novel:per_unit:5
POINTS_LLM_CALL=llm_call:per_cost:100

# 模型价格配置（JSON格式，用于计算实际成本）
# LLM模型价格：{"model_name": {"input": 输入价格(元/百万tokens), "output": 输出价格(元/百万tokens)}}
# 图片模型价格：{"model_name": 价格(元/张)}
# 音频模型价格：{"model_name": 价格(元/兆字节)}
MODEL_PRICES_LLM={"Qwen/Qwen-Plus": {"input": 0.8, "output": 2.0}, "moonshotai/Kimi-K2-Instruct-0905": {"input": 4.0, "output": 16.0},"deepseek-ai/DeepSeek-V3.2": {"input": 2, "output": 3}}
MODEL_PRICES_IMAGE={"black-forest-labs/flux-kontext-pro/multi": 0.35, "Qwen/Qwen-Image": 0.25}
MODEL_PRICES_AUDIO={"s1": 120}
