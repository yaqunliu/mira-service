# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/video_generator
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=video_generator
DATABASE_USER=username
DATABASE_PASSWORD=password

# JWT配置
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时（60分钟 * 24）

# Redis配置
# Redis 数据库编号说明：
# - /0: 数据库0（默认数据库）
# - /1: 数据库1
# - Redis 默认有 16 个数据库（0-15），不同数据库之间数据完全隔离
# Redis 密码（生产环境请务必设置强密码）
# 如果设置了密码，系统会自动更新 REDIS_URL、REDIS_BROKER_URL 和 REDIS_BACKEND_URL
REDIS_PASSWORD=password
REDIS_URL=redis://localhost:6379/0  # 通用 Redis URL（向后兼容，可选，如果设置了密码会自动更新）
REDIS_BROKER_URL=redis://localhost:6379/0  # Celery Broker（任务队列，如果设置了密码会自动更新）
REDIS_BACKEND_URL=redis://localhost:6379/1  # Celery Backend（结果存储，如果设置了密码会自动更新）

# 文件存储配置
UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=104857600  # 100MB in bytes (可选，有默认值)

# AI服务配置（当前接 siray 中转站，OpenAI 兼容）
# 模型名必须带厂商前缀，且与 docs.siray.ai/api-reference/model-api/<模型>.md 的 enum 一致
OPENAI_API_KEY=your-siray-api-key
OPENAI_BASE_URL=https://api.siray.ai/v1
LLM_MODEL_NAME=z-ai/glm-5.2

# 专用LLM模型配置
# 各解析步骤实际读的是这五个，LLM_MODEL_NAME 只在这里没配时兜底
LLM_MODEL_CHARACTER_ANALYSIS=z-ai/glm-5.2
LLM_MODEL_SCENE_ANALYSIS=z-ai/glm-5.2
LLM_MODEL_SHOT_ANALYSIS=z-ai/glm-5.2
LLM_MODEL_SCRIPT_GENERATION=z-ai/glm-5.2
LLM_MODEL_PROMPT_GENERATION=z-ai/glm-5.2

# 图片生成模型配置
# siray 图片接口是异步的（提交 + 轮询），带 -t2i / -i2i 后缀时走专用适配器
IMAGE_MODEL_TEXT_TO_IMAGE=bytedance/seedream-4.5-t2i
IMAGE_MODEL_IMAGE_TO_IMAGE=bytedance/seedream-4.5-i2i
# 旧配置（已废弃，保留用于向后兼容）
# IMAGE_MODEL_NAME=your-image-model-name

# siray 图片生成（留空则复用上面的 OPENAI_*，siray 是统一 key）
SIRAY_API_KEY=
SIRAY_BASE_URL=
# SIRAY_IMAGE_TIMEOUT 必须小于 AI_TIMEOUT，否则轮询会被外层超时提前掐断
SIRAY_IMAGE_POLL_INTERVAL=3
SIRAY_IMAGE_TIMEOUT=280

# AI 超时和重试配置
# AI API调用超时时间（秒），默认120秒
AI_TIMEOUT=600
# 图片下载超时时间（秒），默认60秒
AI_IMAGE_DOWNLOAD_TIMEOUT=60
# 最大重试次数，默认3次
AI_MAX_RETRIES=3
# 重试间隔（秒），默认2秒
AI_RETRY_DELAY=2

# Fish Audio TTS 配置
FISH_AUDIO_API_KEY=your-fish-audio-api-key
FISH_AUDIO_DEFAULT_VOICE_ID=54a5170264694bfc8e9ad98df7bd89c3  # 默认语音模型ID（丁真）
# Fish Audio TTS 模型配置：
# - s1: 旗舰模型，支持完整的情绪控制功能（推荐）
# - speech-1.6: 上一代模型，稳定可靠，仅支持基本情绪
# - speech-1.5: 早期模型，可靠稳定，仅支持基本情绪，资源需求较低
FISH_AUDIO_DEFAULT_MODEL=s1

# 字体配置（用于字幕渲染）
FONT_DIR=static/fonts  # 字体文件本地存储目录
SUBTITLE_FONT_URL=https://novel-agent.cn-sh2.ufileos.com/font/black.ttf  # 字幕字体下载地址
SUBTITLE_FONT_NAME=black.ttf  # 字幕字体文件名

# 云存储配置 (US3)
US3_PUBLIC_KEY=your-us3-public-key
US3_PRIVATE_KEY=your-us3-private-key
DOWNLOAD_SUFFIX=""
UPLOAD_SUFFIX=""
DEFAULT_BUCKET=""
US3_BUCKET=your-bucket-name
US3_REGION=""

# 本地存储（US3 未开通时的降级方案）
# US3 公私钥为空时自动生效。
# PUBLIC_BASE_URL 留空则存容器内绝对路径，浏览器访问不到（页面图片会 404）；
# 填了则存 {PUBLIC_BASE_URL}/uploads/...，同时需要前端把 /uploads 反代到后端。
LOCAL_STORAGE_ENABLED=false
LOCAL_STORAGE_DIR=./local_storage
PUBLIC_BASE_URL=http://localhost:3000


# 应用配置
APP_NAME=Video Generator API
APP_VERSION=0.1.0
DEBUG=True
LOG_LEVEL=INFO
# 环境变量：dev（开发环境）或 production（生产环境），默认 dev
ENV=dev

# CORS配置（允许的前端域名，多个用逗号分隔）
# 开发环境可以留空，将允许所有源
# 生产环境建议配置具体域名，如：http://localhost:3000,https://example.com
BACKEND_CORS_ORIGINS=

# 积分系统配置
# 注册赠送
POINTS_REGISTER_REWARD=10000  # 注册赠送积分

# 每日签到
POINTS_CHECKIN_REWARD=188  # 每日签到积分
POINTS_CHECKIN_EXPIRE_HOURS=0  # 签到积分过期时间（小时），0表示当天24:00过期

# 积分消耗配置（格式：operation_type:计费方式:数值）
POINTS_CREATE_CREATION=create_creation:per_unit:10
POINTS_GENERATE_CHARACTER=generate_character:per_unit:5
POINTS_GENERATE_SHOT=generate_shot:per_unit:3
POINTS_GENERATE_AUDIO=generate_audio:per_second:1
POINTS_GENERATE_VIDEO=generate_video:per_shot:2
POINTS_UPLOAD_NOVEL=upload_novel:per_unit:5
POINTS_LLM_CALL=llm_call:per_cost:100

# 模型价格配置（JSON格式，用于计算实际成本）
# LLM模型价格：{"model_name": {"input": 输入价格(元/百万tokens), "output": 输出价格(元/百万tokens)}}
# 图片模型价格：{"model_name": 价格(元/张)}
# 音频模型价格：{"model_name": 价格(元/兆字节)}
MODEL_PRICES_LLM={"Qwen/Qwen-Plus": {"input": 0.8, "output": 2.0}, "moonshotai/Kimi-K2-Instruct-0905": {"input": 4.0, "output": 16.0},"deepseek-ai/DeepSeek-V3.2": {"input": 2, "output": 3}}
MODEL_PRICES_IMAGE={"black-forest-labs/flux-kontext-pro/multi": 0.35, "Qwen/Qwen-Image": 0.25}
MODEL_PRICES_AUDIO={"s1": 120}

# Supabase 配置
# 本地开发：运行 `supabase status --output json` 查看配置
# 注意：JWT_SECRET 是用于验证 token 的密钥，不是 SECRET_KEY
# 从 supabase status 输出中获取 JWT_SECRET 的值（不是 SECRET_KEY）
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=你的anon_key
SUPABASE_JWT_SECRET=你的jwt_secret
# 本地开发默认值：super-secret-jwt-token-with-at-least-32-characters-long

# Creem 支付配置
CREEM_API_KEY=
CREEM_API_URL=https://api.creem.io
CREEM_TIMEOUT=15
CREEM_WEBHOOK_SECRET=
CREEM_CHECKOUT_SUCCESS_URL=
CREEM_CHECKOUT_CANCEL_URL=

# 微信支付配置
# 微信应用ID（从微信公众平台获取）
WECHAT_APPID=
# 微信商户号（从微信支付商户平台获取）
WECHAT_MCHID=
# APIv3密钥（在微信支付商户平台设置，用于回调通知解密和签名验证）
WECHAT_API_V3_KEY=
# 商户API证书序列号（cert_sn，从商户证书中获取，用于API请求签名，必需）
# 可以通过以下方式获取：
# 1. 从商户证书文件中提取：openssl x509 -in apiclient_cert.pem -noout -serial
# 2. 从微信支付商户平台查看
# 注意：这是商户API证书序列号，不是平台证书序列号
WECHAT_CERT_SERIAL_NO=
# 商户API证书私钥文件路径（apiclient_key.pem，必需，用于API请求签名）
# 用途：商户向微信支付发送请求时，使用此私钥对请求进行签名
# 获取方式：从微信支付商户平台下载商户API证书，解压后得到 apiclient_key.pem
# 参考文档：https://pay.weixin.qq.com/doc/v3/merchant/4013053420
# 示例：/path/to/apiclient_key.pem
WECHAT_PRIVATE_KEY_PATH=
# 微信支付平台证书文件路径（wechatpay_cert.pem，可选，用于验证回调签名）
# 注意：平台证书与商户API证书是不同的证书，用途不同：
# - 商户API证书私钥（apiclient_key.pem）：商户用于签名请求到微信支付（必需）
# - 平台证书（wechatpay_cert.pem）：商户用于验证微信支付回调通知的签名（可选但建议配置）
# 
# 为什么需要两个证书？
# 1. 商户API证书：商户自己的证书，用于签名发送给微信支付的请求
# 2. 平台证书：微信支付的证书，用于验证微信支付发送给商户的回调通知
# 
# 验签流程（参考：https://pay.weixin.qq.com/doc/v3/merchant/4013053420）：
# - 微信支付使用平台证书私钥对回调通知进行签名
# - 商户使用平台证书公钥验证回调通知的签名
# - 如果未配置平台证书，代码会跳过回调签名验证（开发环境可接受，生产环境建议配置）
# 
# 获取方式：
# 1. 首次下载：使用微信支付提供的证书工具下载（参考官方文档）
# 2. 后续更新：使用微信支付平台证书下载接口自动获取
# 示例：/path/to/wechatpay_cert.pem
WECHAT_CERT_PATH=
# 支付回调通知URL（微信支付会向此URL发送支付结果通知）
# 完整路径：https://api.mira-studio.ai/api/v1/webhooks/wechat
# 注意：URL必须是公网可访问的，不能携带参数，必须以 http:// 或 https:// 开头
WECHAT_NOTIFY_URL=https://api.mira-studio.ai/api/v1/webhooks/wechat
# 微信支付API基础URL（默认值，一般不需要修改）
WECHAT_API_BASE_URL=https://api.mch.weixin.qq.com
# 是否使用仿真系统（沙箱环境）
# 注意：微信支付V3 API没有沙箱环境，此参数对V3 API无效
# V3 API的所有请求都会发送到生产环境（https://api.mch.weixin.qq.com）
# 此参数仅保留用于向后兼容，实际不会影响V3 API的调用
# 默认值：false
WECHAT_USE_SANDBOX=false
# 微信支付API超时时间（秒），默认60秒
WECHAT_TIMEOUT=60
# 微信支付API最大重试次数，默认3次
WECHAT_MAX_RETRIES=3
# 微信支付API重试间隔（秒），默认2秒
WECHAT_RETRY_DELAY=2
